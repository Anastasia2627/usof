DB_HOST=127.0.0.1
# Circle's isolated Docker MySQL uses port 3307, not Homebrew's 3306.
DB_PORT=3307
DB_NAME=usof
DB_USER=circle
# Choose a unique local development password in your uncommitted .env.
DB_PASSWORD=
# Needed only for the Docker image initial root account (not used by Node).
CIRCLE_MYSQL_ROOT_PASSWORD=
APP_PORT=5000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TOKEN_TTL=12h
CLIENT_ORIGIN=http://localhost:5173
VITE_API_ORIGIN=http://localhost:5000
# Real email delivery (e.g. Gmail): set ALL fields below in your local .env.
# Gmail account with 2-step verification: create an App Password; never use your
# regular Gmail password. Keep these values on the backend ONLY.
MAIL_HOST=smtp.gmail.com
# 465 = TLS from connection start; 587 = STARTTLS
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Only for isolated local debugging without SMTP; NEVER on a public server.
ALLOW_DEV_VERIFICATION_TOKENS=false

# Google OAuth web client ID. Use the same value on backend and Vite frontend.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
